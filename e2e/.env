# Appium & Device Environment Configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PATH=/

# APK Configuration
APK_PATH=./build/app/outputs/flutter-apk/app-release.apk
APP_PACKAGE=com.example.lumixxx
APP_ACTIVITY=com.example.lumixxx.MainActivity

# Execution Settings
AUTOMATION_NAME=UiAutomator2
FALLBACK_AUTOMATION_NAME=Flutter
DEVICE_NAME=Android Emulator
PLATFORM_NAME=Android
PLATFORM_VERSION=14.0
AUTO_GRANT_PERMISSIONS=true
NO_RESET=false
FULL_RESET=false

# Timeouts (ms)
EXPLICIT_WAIT_MS=15000
COMMAND_TIMEOUT_MS=60000

# Reports & Screenshots
REPORTS_DIR=./reports
FAILURES_DIR=./reports/failures
